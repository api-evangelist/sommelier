      "item": [
        {
          "id": "6bff9de3-bbee-4bf0-845d-44c2eada3110",
          "name": "Get daily vault data",
          "request": {
            "name": "Get daily vault data",
            "description": {
              "content": "Returns daily snapshots of a vault, captured at midnight UTC. Includes the daily APY (already decimal-adjusted), share price, base-asset price, total assets and USD-denominated TVL for each day in the requested range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dailyData",
                ":network",
                ":vaultAddress",
                ":startUnixTimestamp",
                ":endUnixTimestamp"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "network",
                  "description": "(Required) The network the vault is on. Currently supports: ethereum."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vaultAddress",
                  "description": "(Required) The address of the vault you want data for."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "startUnixTimestamp",
                  "description": "(Required) The unix timestamp of the start of the data you want."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "endUnixTimestamp",
                  "description": "(Required) The unix timestamp of the end of the data you want. Replace with the word `latest` to get all data up to the present time."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
